# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Shopify ───────────────────────────────────────────────────────────────────
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_...

# ── WhatsApp Cloud API ────────────────────────────────────────────────────────
WHATSAPP_TOKEN=EAAxxxxxxxxx          # System user token or page token
WHATSAPP_PHONE_NUMBER_ID=1234567890  # Phone number ID from Meta dashboard

# ── Facebook Messenger / Instagram DMs ───────────────────────────────────────
FB_PAGE_ACCESS_TOKEN=EAAxxxxxxxxx    # Page access token (long-lived)

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_VERIFY_TOKEN=futboleros_verify   # Must match what you set in Meta dashboard
PORT=3000
